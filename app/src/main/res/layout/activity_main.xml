<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF5FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="34dp"
        android:paddingEnd="24dp"
        android:paddingBottom="34dp">


        <!-- ========================= -->
        <!-- HEADER -->
        <!-- ========================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#CDE6F8"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="01  •  STUDENT PROFILE"
            android:textColor="#487897"
            android:textSize="11sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Create Your\nDigital Identity."
            android:textColor="#18384F"
            android:textSize="39sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Lengkapi identitas mahasiswa untuk membuat Student Digital ID."
            android:textColor="#718B9E"
            android:textSize="15sp" />


        <!-- ========================= -->
        <!-- PROGRESS DECORATION -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <View
                android:layout_width="75dp"
                android:layout_height="7dp"
                android:background="#5796C4" />

            <View
                android:layout_width="18dp"
                android:layout_height="7dp"
                android:layout_marginStart="6dp"
                android:background="#A8CFEB" />

            <View
                android:layout_width="18dp"
                android:layout_height="7dp"
                android:layout_marginStart="6dp"
                android:background="#C9E3F6" />

        </LinearLayout>


        <!-- ========================= -->
        <!-- FORM -->
        <!-- ========================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="PERSONAL INFORMATION"
            android:textColor="#416984"
            android:textSize="12sp"
            android:textStyle="bold" />


        <!-- NAMA -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="FULL NAME"
            android:textColor="#7893A6"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNama"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#6FA8CF"
            android:hint="Masukkan nama lengkap"
            android:inputType="textCapWords"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="#18384F"
            android:textColorHint="#9BB0BF"
            android:textSize="16sp" />


        <!-- NRP -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="NRP / STUDENT NUMBER"
            android:textColor="#7893A6"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNrp"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#6FA8CF"
            android:hint="Contoh: 5025251001"
            android:inputType="number"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="#18384F"
            android:textColorHint="#9BB0BF"
            android:textSize="16sp" />


        <!-- DEPARTEMEN -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="DEPARTMENT"
            android:textColor="#7893A6"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDepartemen"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#6FA8CF"
            android:hint="Contoh: Teknologi Informasi"
            android:inputType="textCapWords"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="#18384F"
            android:textColorHint="#9BB0BF"
            android:textSize="16sp" />


        <!-- TTL -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="PLACE &amp; DATE OF BIRTH"
            android:textColor="#7893A6"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTtl"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#6FA8CF"
            android:hint="Contoh: Surabaya, 12 Mei 2007"
            android:inputType="textCapWords"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="#18384F"
            android:textColorHint="#9BB0BF"
            android:textSize="16sp" />


        <!-- ANGKATAN -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="ENTRY YEAR"
            android:textColor="#7893A6"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAngkatan"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#6FA8CF"
            android:hint="Contoh: 2025"
            android:inputType="number"
            android:maxLength="4"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="#18384F"
            android:textColorHint="#9BB0BF"
            android:textSize="16sp" />


        <!-- EMAIL -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="ACADEMIC EMAIL"
            android:textColor="#7893A6"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#6FA8CF"
            android:hint="nama@student.ac.id"
            android:inputType="textEmailAddress"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="#18384F"
            android:textColorHint="#9BB0BF"
            android:textSize="16sp" />


        <!-- ========================= -->
        <!-- BUTTON -->
        <!-- ========================= -->

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="34dp"
            android:backgroundTint="#4F89B5"
            android:text="CREATE MY PROFILE   →"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />


        <!-- FOOTER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:text="STUDENT DIGITAL IDENTITY SYSTEM"
            android:textColor="#8BA2B3"
            android:textSize="9sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>